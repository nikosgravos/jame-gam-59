  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'THE DARKNESS GIVES WAY TO ANOTHER MOMENT THAT SHOULD HAVE BEEN DIFFERENT.


    A MAN SITS BENEATH A TREE, WAITING FOR THE LAWS OF NATURE TO REVEAL THEMSELVES.


    AN APPLE IS EXPECTED TO FALL.


    SOMETHING ELSE TAKES ITS PLACE.


    THE SAME RED. THE SAME ROUND FORM. ANOTHER FRUIT STEALING A MOMENT THAT WAS NEVER MEANT FOR IT.


    STEALING ANOTHER PIECE OF HISTORY.


    OUT OF PURE HATRED.


    <b>BUT EVEN THOUGH THE FRUIT MAY CHANGE, THE ROOT REMAINS.</b>'
